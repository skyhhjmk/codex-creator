####
# Runtime image for the Quarkus native executable.
# Build the executable first with:
# ./mvnw -DskipTests -Dnative -Dquarkus.native.container-build=true package
###
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7

WORKDIR /work/

# ubi-minimal already provides curl-minimal for the Compose readiness probe.
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8090
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
