POSTGRES_DB=codex_creator
POSTGRES_USER=codex_creator
POSTGRES_PASSWORD=change-me-before-start
REDIS_PASSWORD=change-me-before-start

# Shared native/Compose connection settings. Native mode uses these directly;
# Compose may override the hostnames with its internal service names.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

CODEX_CREATOR_HTTP_HOST=0.0.0.0
CODEX_CREATOR_HTTP_PORT=8681
CODEX_CREATOR_ADMIN_TOKEN=replace-with-a-long-random-token
CODEX_CREATOR_INTERNAL_SHARED_SECRET=replace-with-a-long-random-secret
CODEX_CREATOR_MCP_BEARER_TOKEN=replace-with-a-long-random-token
CODEX_RELEASE=0.150.1
CODEX_COMMAND=codex
CODEX_APP_SERVER_ENABLED=false
# Set exactly one for headless app-server automation; the entrypoint logs in
# through stdin and never writes either credential into the image.
# OPENAI_API_KEY=replace-with-openai-api-key
# CODEX_ACCESS_TOKEN=replace-with-codex-access-token
