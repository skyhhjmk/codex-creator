POSTGRES_DB=codex_creator
POSTGRES_USER=codex_creator
POSTGRES_PASSWORD=change-me-before-start
REDIS_PASSWORD=change-me-before-start

# Shared native/Compose connection settings. Native mode uses the published
# loopback ports below; Compose overrides the hostnames with internal names.
CODEX_CREATOR_DB_HOST_BIND_IP=127.0.0.1
CODEX_CREATOR_DB_HOST_PORT=55433
CODEX_CREATOR_REDIS_HOST_BIND_IP=127.0.0.1
CODEX_CREATOR_REDIS_HOST_PORT=56380
DB_HOST=127.0.0.1
DB_PORT=${CODEX_CREATOR_DB_HOST_PORT}
DB_NAME=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
REDIS_HOST=127.0.0.1
REDIS_PORT=${CODEX_CREATOR_REDIS_HOST_PORT}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

CODEX_CREATOR_HTTP_HOST=0.0.0.0
CODEX_CREATOR_HTTP_PORT=8681
QUARKUS_DEVSERVICES_ENABLED=false
CODEX_CREATOR_ADMIN_TOKEN=replace-with-a-long-random-token
CODEX_CREATOR_INTERNAL_SHARED_SECRET=replace-with-a-long-random-secret
CODEX_CREATOR_MCP_BEARER_TOKEN=replace-with-a-long-random-token
CODEX_CREATOR_WINDBLOG_ENDPOINT=http://windblog:8080
# Keep this equal to the WindBlog-side shared secret.
CODEX_CREATOR_WINDBLOG_SHARED_SECRET=${CODEX_CREATOR_INTERNAL_SHARED_SECRET}
CODEX_CREATOR_WINDBLOG_MAX_IMAGE_BYTES=8388608
CODEX_CREATOR_PROMPT_VERSION=2
CODEX_CREATOR_ARTICLE_REASONING_EFFORT=high
CODEX_CREATOR_TOPIC_REASONING_EFFORT=medium
CODEX_CREATOR_ARTICLE_MAX_QUALITY_ATTEMPTS=2
CODEX_CREATOR_ARTICLE_MIN_CJK_CHARACTERS=1200
CODEX_CREATOR_ARTICLE_MIN_WORDS=900
CODEX_CREATOR_ARTICLE_MIN_SOURCES=2
CODEX_RELEASE=0.150.1
CODEX_COMMAND=codex
CODEX_APP_SERVER_ENABLED=false
# Set exactly one for headless app-server automation; the entrypoint logs in
# through stdin and never writes either credential into the image.
# OPENAI_API_KEY=replace-with-openai-api-key
# CODEX_ACCESS_TOKEN=replace-with-codex-access-token
